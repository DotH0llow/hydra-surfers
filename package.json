{
  "name": "yard-dash",
  "private": true,
  "version": "0.1.0",
  "description": "Yard Dash: an original mobile-first 3-lane endless runner (Vite + TypeScript + three.js).",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
