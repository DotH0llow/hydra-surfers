// Cloudflare Workers config: static assets from dist/ (SPA fallback) + API Worker on /api/*.
// Docs: docs/DEPLOY.md (deploy paths, secrets, custom domain) and docs/ONLINE.md (D1).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yard-dash",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown non-API paths serve index.html (client-side routing, deep links).
    "not_found_handling": "single-page-application",
    // Only /api/* invokes the Worker; everything else is served straight from the asset store.
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "vars": { "APP_VERSION": "0.1.0" }

  // Optional D1 leaderboard database. Without it /api/leaderboard and /api/scores return 503 and
  // the client uses its mock provider. To enable (see docs/ONLINE.md):
  //   npx wrangler d1 create yard-dash
  //   then uncomment and paste the database_id below.
  // ,"d1_databases": [
  //   { "binding": "DB", "database_name": "yard-dash", "database_id": "<paste-id>" }
  // ]
}
